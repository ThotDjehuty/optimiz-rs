# Copy to deploy/.env and replace values; docker compose --env-file deploy/.env -f deploy/compose.yaml up -d
# Use an actual published image digest for production. Local build tags may be used for development.
ANALYTICS_IMAGE=docker.io/replace/analytics@sha256:REPLACE_WITH_REAL_IMAGE_DIGEST
# Paths are resolved relative to deploy/compose.yaml. Files must be readable by
# container users; protect their parent directory from other host users.
ANALYTICS_TOKEN_FILE=./secrets/analytics_token
GRAFANA_PASSWORD_FILE=./secrets/grafana_password
GRAFANA_ADMIN_USER=admin
# Grafana only consumes its initial admin password on the first volume startup.
# Rotate an existing instance's password using Grafana's authenticated admin API.
